n:"Create a sleek, modern landing page",icon:H.SelectWindow,action:{type:"modality",modality:i.EEvaluationModality.WEBDEV},template:"Create a premium, modern, conversion-focused landing page for [Brand/Product Name] targeting [Target Audience], with the goal of [Primary Goal]. Design it with the polish of leading tech brands—clean typography, generous whitespace, refined gradients, subtle glassmorphism, premium visuals, and smooth, elegant animations including scroll reveals, staggered entrances, hover effects, ambient motion, and interactive microinteractions. Include a complete landing page structure (sticky navbar, hero, social proof, features, product showcase, benefits, testimonials, pricing, FAQ, CTA, and footer), ensuring it is fully responsive, accessible, mobile-first, visually stunning, and production-ready with compelling copy tailored to the brand."},{id:"build-dashboard",headline:"Build a dashboard",description:"Turn data into interactive charts",icon:H.StatsReport,action:{type:"modality",modality:i.EEvaluationModality.WEBDEV},template:"Create an interactive analytics dashboard for [Domain — e.g. SaaS metrics, fitness tracking, personal finance] aimed at [Users]. Include KPI summary cards with trend indicators, a mix of line, bar, and donut charts with hover tooltips and smooth transitions, a sortable and filterable data table, and date-range and segment filters that update every view live. Use a clean, modern visual style with clear layout hierarchy and a dark mode toggle, generate realistic sample data so every chart feels alive, and make it fully responsive."},{id:"make-a-game",headline:"Make a game",description:"Build a playable browser game",icon:H.Arcade,action:{type:"modality",modality:i.EEvaluationModality.WEBDEV},template:"Build a polished, playable browser game: [Game Idea — e.g. a fast-paced snake remix, a physics puzzler, a typing racer]. Make the core loop fun within the first ten seconds, with tight controls for both keyboard and touch, and juicy feedback — screen shake, particle effects, and satisfying animations. Include a start screen, a score system, pause and game-over states with instant restart, and a local high-score table. Style it with a cohesive visual theme and make sure it runs smoothly at 60fps on desktop and mobile."},{id:"design-to-code",headline:"Design to Code",description:"Upload an image and have AI build it",icon:H.FrameSelect,action:{type:"modality",modality:i.EEvaluationModality.WEBDEV,opensFilePicker:!0},template:"Recreate the attached design as a pixel-perfect, production-ready web page. Match the layout, spacing, typography, colors, and imagery exactly, and implement it with clean, semantic markup and modern CSS. Make it fully responsive across mobile, tablet, and desktop, add tasteful hover states and scroll animations that fit the design's style, and where any detail is ambiguous, make polished, on-brand decisions that elevate the original."},{id:"build-fullstack-app",headline:"Build a fullstack app",description:"Create a templated full-stack app",icon:H.Database,action:{type:"modality",modality:i.EEvaluationModality.WEBDEV},template:"Build a full-stack [App Type — e.g. task manager, booking tool, team dashboard] for [Target Users] with [Key Features]. Include authentication, a clean dashboard layout with sidebar navigation, full CRUD flows for the core resources, and persistent data storage. Use a modern, polished UI with empty states, loading states, optimistic updates, and responsive design, and seed it with realistic demo data so the app feels alive on first load."},{id:"launch-storefront",headline:"Launch a storefront",description:"Create a beautiful online shop",icon:H.ShopFourTiles,action:{type:"modality",modality:i.EEvaluationModality.WEBDEV},template:"Build a beautiful e-commerce storefront for [Store Name] selling [Product Type] to [Target Customers]. Include a striking home page with featured collections, a product grid with filters and sorting, rich product detail pages with image galleries and reviews, a slide-out cart, and a streamlined checkout flow. Use elegant typography, premium product imagery, tasteful animations, and persistent cart state, and seed it with realistic demo products, prices, and reviews so the shop feels open for business — all fully responsive and production-ready."}];function eZ(e){let i,s,n,r,l,d,c=(0,a.c)(28),{openFilePicker:u}=e,{navigate:m}=(0,eY.useEvaluationRoute)(),f=(0,eK.useSetAtom)(eq.prefillMessageAtom),h=(0,R.useUserStore)(eQ),g=(0,o.useRouter)(),p=!0===(0,eo.useFlag)("image-edit-promo-banner");if(c[0]!==p||c[1]!==m||c[2]!==u||c[3]!==g||c[4]!==f||c[5]!==h){let e,a,o;c[10]!==p?(e=e=>p?"launch-storefront"!==e.id:"edit-image"!==e.id,c[10]=p,c[11]=e):e=c[11];let l=eX.filter(e);c[12]!==m||c[13]!==u||c[14]!==g||c[15]!==f||c[16]!==h?(a=e=>{let{action:t}=e;if(Y.analytics.capture({action:"homepage_cta_click",params:{cta_id:e.id,target_modality:"agent"===t.type?"agentic":t.modality,user_id:h}}),"agent"===t.type){sessionStorage.setItem(eJ.CHAT_DRAFT_SESSION_KEY,e.template),g.push("/agent");return}t.opensFilePicker?u(()=>{f(e.template),m({modality:t.modality})}):(m({modality:t.modality}),f(e.template))},c[12]=m,c[13]=u,c[14]=g,c[15]=f,c[16]=h,c[17]=a):a=c[17];let d=a;n="flex w-full flex-col gap-2",c[18]===Symbol.for("react.memo_cache_sentinel")?(r=(0,t.jsx)("span",{className:"body-xs text-text-tertiary !font-book motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-5 motion-safe:fill-mode-both text-left motion-safe:duration-300 motion-safe:ease-out",children:"Get started"}),c[18]=r):r=c[18],i="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0",c[19]!==d?(o=(e,a)=>{let i=e.icon;return(0,t.jsxs)("button",{type:"button",style:{animationDelay:`${35*a}ms`},onClick:()=>d(e),className:"border-border-medium bg-surface-primary hover:bg-surface-tertiary focus-visible:ring-ring focus-visible:ring-offset-surface-primary motion-